# Dependencies
vendor/
node_modules/

# Compiled
*.map
"student-lms-project.tar.gz"

# Private uploads: homework, help-desk files, payment slips (never commit client files)
storage/uploads/attachments/
storage/uploads/materials/*

# Database dumps: data snapshots, not source -- may contain student/parent PII
storage/backups/*.sql
database/backup_before_030.sql
