# Environment
.env
*.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Uploads (keep structure, ignore actual uploaded files)
public/uploads/profiles/*
!public/uploads/profiles/.gitkeep
storage/uploads/profiles/*
!storage/uploads/profiles/.gitkeep

# Storage
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
